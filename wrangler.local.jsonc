{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birdahead-local",
  "main": "app/worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": { "APP_ORIGIN": "http://127.0.0.1:8788", "DEPLOY_REVISION": "local" },
  "d1_databases": [
    { "binding": "DB", "database_name": "birdahead-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "birdahead-local-private" }],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "73101", "simple": { "limit": 10, "period": 60 } },
    { "name": "PUBLISH_LIMIT", "namespace_id": "73102", "simple": { "limit": 600, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
