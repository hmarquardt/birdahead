{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birdahead",
  "account_id": "b1aa310aa0a1638d72b8b086a21e557c",
  "main": "app/worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "birdahead.com", "zone_id": "03524416f9bc90b22119b587716866ef", "custom_domain": true },
    { "pattern": "www.birdahead.com", "zone_id": "03524416f9bc90b22119b587716866ef", "custom_domain": true }
  ],
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": { "APP_ORIGIN": "https://birdahead.com", "DEPLOY_REVISION": "unreleased" },
  "secrets": { "required": ["HANK_KEY", "HEATHER_KEY", "PUBLISH_TOKEN"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "birdahead", "database_id": "ce2302c9-988b-490c-9ad3-3035d0a57c8b", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "birdahead-private" }],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "73101", "simple": { "limit": 10, "period": 60 } },
    { "name": "PUBLISH_LIMIT", "namespace_id": "73102", "simple": { "limit": 600, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
